    <!-- ==================== LOGIK PERMAINAN, KAMERA & GERAKAN TANGAN ==================== -->
    <script>
        /**
         * DATA 5 SOALAN PENDIDIKAN INFLUENZA TAHUN 4
         */
        const QUESTIONS = [
            {
                tag: "UJIAN MAKMAL 1 • PUNCA JANGKITAN",
                question: "Apakah punca utama jangkitan penyakit Influenza?",
                options: [
                    "Jangkitan Virus Influenza",
                    "Terlalu banyak minum air kosong",
                    "Gigitan nyamuk pada waktu malam"
                ],
                correct: 0,
                explanation: "Betul! Influenza berpunca daripada jangkitan Virus Influenza yang menyerang saluran pernafasan."
            },
            {
                tag: "UJIAN MAKMAL 2 • CARA PENULARAN",
                question: "Bagaimanakah virus influenza paling mudah merebak kepada orang lain?",
                options: [
                    "Melalui cahaya matahari pagi",
                    "Titisan pernafasan semasa batuk dan bersin",
                    "Memakai pakaian yang bersih dan kemas"
                ],
                correct: 1,
                explanation: "Tepat! Titisan air liur atau hingus ketika pesakit batuk dan bersin membawa partikel virus ke udara."
            },
            {
                tag: "UJIAN MAKMAL 3 • GEJALA UTAMA",
                question: "Antara berikut, yang manakah gejala lazim bagi murid yang dijangkiti influenza?",
                options: [
                    "Gigi tumbuh dengan lebih cepat",
                    "Demam panas, batuk, sakit tekak dan lenguh badan",
                    "Kuku tangan bertukar menjadi warna biru"
                ],
                correct: 1,
                explanation: "Tahniah! Demam tinggi, batuk, sakit tekak dan keletihan ialah tanda utama jangkitan influenza."
            },
            {
                tag: "UJIAN MAKMAL 4 • SENTUHAN PERMUKAAN",
                question: "Apakah yang berlaku jika kita menyentuh tombol pintu yang tercemar dengan virus lalu menyentuh hidung?",
                options: [
                    "Virus boleh masuk ke dalam badan dan menyebabkan jangkitan",
                    "Tangan kita akan menjadi lebih bersih serta wangi",
                    "Virus akan hilang secara automatik dengan serta-merta"
                ],
                correct: 0,
                explanation: "Benar! Tangan yang menyentuh permukaan tercemar boleh memindahkan virus ke mata, hidung atau mulut."
            },
            {
                tag: "UJIAN MAKMAL 5 • LANGKAH PENCEGAHAN",
                question: "Apakah amalan terbaik untuk mengelakkan penularan virus influenza di sekolah?",
                options: [
                    "Berkongsi sapu tangan dan botol air dengan rakan",
                    "Kerap mencuci tangan dengan sabun dan menutup mulut ketika bersin",
                    "Batuk secara terbuka ke arah makanan rakan"
                ],
                correct: 1,
                explanation: "Hebat! Mencuci tangan dengan sabun dan mengamalkan adab batuk/bersin menghalang virus daripada merebak."
            }
        ];

        /**
         * KEADAAN PERMAINAN (GAME STATE)
         */
        let currentQuestionIndex = 0;
        let score = 0;
        let correctCount = 0;
        let isAnswered = false;
        let gameActive = false;
        let useCameraMode = false;

        // Kedudukan Penunjuk Bulatan Tenaga
        let cursorX = window.innerWidth / 2;
        let cursorY = window.innerHeight / 2;
        let targetCursorX = window.innerWidth / 2;
        let targetCursorY = window.innerHeight / 2;

        // Pemasa Gelang Kemajuan 2 Saat (2000ms)
        const DWELL_DURATION = 2000; 
        const RING_CIRCUMFERENCE = 213.6;
        let hoveredElement = null;
        let hoverStartTime = 0;
        let lastFrameTime = performance.now();

        // Pemboleh ubah Kamera & Pengesanan Gerakan Tangan
        let mediaStream = null;
        let prevFrameData = null;

        // Elemen DOM
        const startScreen = document.getElementById('start-screen');
        const gameScreen = document.getElementById('game-screen');
        const resultScreen = document.getElementById('result-screen');

        const energyCursor = document.getElementById('energy-cursor');
        const dwellRing = document.getElementById('dwell-ring');

        const questionTag = document.getElementById('question-tag');
        const questionText = document.getElementById('question-text');
        const progressBadge = document.getElementById('progress-badge');
        const progressBarFill = document.getElementById('progress-bar-fill');
        const scoreBadge = document.getElementById('score-badge');

        const answerCards = Array.from(document.querySelectorAll('.answer-card'));
        const activeHintBar = document.getElementById('active-hint-bar');
        const explanationPanel = document.getElementById('explanation-panel');
        const feedbackBadge = document.getElementById('feedback-badge');
        const explanationText = document.getElementById('explanation-text');
        const btnNextQuestion = document.getElementById('btn-next-question');

        const webcamVideo = document.getElementById('webcam-video');
        const motionCanvas = document.getElementById('motion-canvas');
        const motionCtx = motionCanvas.getContext('2d', { willReadFrequently: true });
        const cameraPlaceholder = document.getElementById('camera-placeholder');
        const camTrackerDot = document.getElementById('cam-tracker-dot');
        const controlStatusLabel = document.getElementById('control-status-label');

        /**
         * KESAN BUNYI MAKMAL CERIA (Tone.js)
         */
        let synth = null;
        function initAudio() {
            if (!synth && window.Tone) {
                Tone.start();
                synth = new Tone.PolySynth(Tone.Synth).toDestination();
                synth.volume.value = -8;
            }
        }

        function playSound(type) {
            try {
                initAudio();
                if (!synth) return;
                const now = Tone.now();
                if (type === 'hover') {
                    synth.triggerAttackRelease("C5", "32n", now);
                } else if (type === 'correct') {
                    synth.triggerAttackRelease(["C5", "E5", "G5", "C6"], "8n", now);
                } else if (type === 'wrong') {
                    synth.triggerAttackRelease(["F3", "B3"], "8n", now);
                } else if (type === 'win') {
                    synth.triggerAttackRelease(["C5", "E5", "G5"], "16n", now);
                    synth.triggerAttackRelease(["D5", "F5", "A5"], "16n", now + 0.15);
                    synth.triggerAttackRelease(["E5", "G5", "C6"], "4n", now + 0.3);
                }
            } catch (e) {
                // Abaikan jika audio disekat pelayar
            }
        }

        /**
         * FUNGSI KAMERA & PENGESANAN GERAKAN TANGAN
         */
        async function startCamera() {
            try {
                if (mediaStream) {
                    useCameraMode = true;
                    updateControlUI();
                    return true;
                }
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { width: 320, height: 240, facingMode: "user" },
                    audio: false
                });
                mediaStream = stream;
                webcamVideo.srcObject = stream;
                await webcamVideo.play();
                useCameraMode = true;
                prevFrameData = null;
                updateControlUI();
                return true;
            } catch (err) {
                // Jika kamera gagal atau tidak dibenarkan, tukar ke mod sentuhan secara lancar
                useCameraMode = false;
                updateControlUI();
                return false;
            }
        }

        function stopCamera() {
            if (mediaStream) {
                mediaStream.getTracks().forEach(track => track.stop());
                mediaStream = null;
            }
            webcamVideo.srcObject = null;
            useCameraMode = false;
            updateControlUI();
        }

        function updateControlUI() {
            if (useCameraMode && mediaStream) {
                webcamVideo.classList.remove('hidden');
                cameraPlaceholder.classList.add('hidden');
                camTrackerDot.classList.remove('hidden');
                controlStatusLabel.textContent = "Kamera Aktif";
            } else {
                webcamVideo.classList.add('hidden');
                cameraPlaceholder.classList.remove('hidden');
                camTrackerDot.classList.add('hidden');
                controlStatusLabel.textContent = "Sentuhan / Tetikus";
            }
        }

        /**
         * Mengesan pusat gerakan tangan daripada bingkai video kamera
         */
        function processCameraMotion() {
            if (!useCameraMode || !mediaStream || webcamVideo.readyState < 2) return;

            const w = motionCanvas.width;
            const h = motionCanvas.height;

            // Lukis imej video yang dicerminkan ke kanvas kecil
            motionCtx.save();
            motionCtx.scale(-1, 1);
            motionCtx.drawImage(webcamVideo, -w, 0, w, h);
            motionCtx.restore();

            const currentFrame = motionCtx.getImageData(0, 0, w, h);
            const data = currentFrame.data;

            if (prevFrameData) {
                let sumX = 0;
                let sumY = 0;
                let motionPixels = 0;

                for (let y = 0; y < h; y += 2) {
                    for (let x = 0; x < w; x += 2) {
                        const i = (y * w + x) * 4;
                        const diffR = Math.abs(data[i] - prevFrameData[i]);
                        const diffG = Math.abs(data[i + 1] - prevFrameData[i + 1]);
                        const diffB = Math.abs(data[i + 2] - prevFrameData[i + 2]);

                        if (diffR + diffG + diffB > 75) {
                            sumX += x;
                            sumY += y;
                            motionPixels++;
                        }
                    }
                }

                // Kemas kini sasaran penunjuk jika gerakan tangan mencukupi
                if (motionPixels > 12) {
                    const avgX = sumX / motionPixels;
                    const avgY = sumY / motionPixels;

                    // Petakan ruang tengah kamera supaya mudah mencapai tepi skrin
                    const normX = Math.min(1, Math.max(0, (avgX - w * 0.15) / (w * 0.7)));
                    const normY = Math.min(1, Math.max(0, (avgY - h * 0.15) / (h * 0.7)));

                    targetCursorX = normX * window.innerWidth;
                    targetCursorY = normY * window.innerHeight;

                    // Kemas kini titik pada pratonton kamera
                    camTrackerDot.style.left = `${normX * 100}%`;
                    camTrackerDot.style.top = `${normY * 100}%`;
                }
            }

            prevFrameData = new Uint8ClampedArray(data);
        }

        /**
         * MEMULAKAN PERMAINAN & MEMAPARKAN SOALAN
         */
        async function startGame(withCamera) {
            initAudio();
            currentQuestionIndex = 0;
            score = 0;
            correctCount = 0;
            isAnswered = false;
            gameActive = true;

            startScreen.classList.add('hidden');
            resultScreen.classList.add('hidden');
            gameScreen.classList.remove('hidden');
            energyCursor.style.display = 'flex';

            if (withCamera) {
                await startCamera();
            } else {
                stopCamera();
            }

            loadQuestion(currentQuestionIndex);
        }

        function loadQuestion(index) {
            isAnswered = false;
            hoveredElement = null;
            resetDwellRing();

            const q = QUESTIONS[index];
            questionTag.textContent = q.tag;
            questionText.textContent = q.question;

            progressBadge.textContent = `${index + 1} / ${QUESTIONS.length}`;
            progressBarFill.style.width = `${((index + 1) / QUESTIONS.length) * 100}%`;
            scoreBadge.textContent = score;

            // Paparkan semula kad jawapan dengan bersih
            answerCards.forEach((card, idx) => {
                card.classList.remove('targeted', 'correct', 'wrong');
                const textEl = card.querySelector('p');
                const iconEl = card.querySelector('.option-status-icon');
                textEl.textContent = q.options[idx];
                iconEl.classList.add('hidden');
                iconEl.textContent = '';
            });

            // Sembunyikan panel penerangan & tunjukkan bar petunjuk
            explanationPanel.classList.add('hidden');
            activeHintBar.classList.remove('hidden');
        }

        /**
         * MENGESAHKAN PILIHAN JAWAPAN
         */
        function selectAnswer(selectedIndex) {
            if (isAnswered) return;
            isAnswered = true;
            resetDwellRing();

            const q = QUESTIONS[currentQuestionIndex];
            const isCorrect = selectedIndex === q.correct;

            answerCards.forEach((card, idx) => {
                card.classList.remove('targeted');
                const iconEl = card.querySelector('.option-status-icon');

                if (idx === q.correct) {
                    card.classList.add('correct');
                    iconEl.textContent = '✓';
                    iconEl.classList.remove('hidden');
                } else if (idx === selectedIndex && !isCorrect) {
                    card.classList.add('wrong');
                    iconEl.textContent = '✕';
                    iconEl.classList.remove('hidden');
                }
            });

            if (isCorrect) {
                score += 20;
                correctCount++;
                scoreBadge.textContent = score;
                feedbackBadge.textContent = "BETUL! +20 MARKAH";
                feedbackBadge.className = "px-3 py-1 rounded-xl font-extrabold text-xs sm:text-sm shrink-0 bg-emerald-100 text-emerald-800 border border-emerald-400";
                playSound('correct');
            } else {
                feedbackBadge.textContent = "KURANG TEPAT";
                feedbackBadge.className = "px-3 py-1 rounded-xl font-extrabold text-xs sm:text-sm shrink-0 bg-rose-100 text-rose-800 border border-rose-400";
                playSound('wrong');
            }

            explanationText.textContent = q.explanation;
            activeHintBar.classList.add('hidden');
            explanationPanel.classList.remove('hidden');

            // Kemas kini teks butang jika soalan terakhir
            const nextSpan = btnNextQuestion.querySelector('span');
            if (currentQuestionIndex === QUESTIONS.length - 1) {
                nextSpan.textContent = "Lihat Keputusan";
            } else {
                nextSpan.textContent = "Seterusnya";
            }
        }

        function goToNextQuestion() {
            if (currentQuestionIndex < QUESTIONS.length - 1) {
                currentQuestionIndex++;
                loadQuestion(currentQuestionIndex);
            } else {
                showResults();
            }
        }

        function showResults() {
            gameActive = false;
            energyCursor.style.display = 'none';
            gameScreen.classList.add('hidden');
            resultScreen.classList.remove('hidden');

            document.getElementById('final-score').textContent = score;
            document.getElementById('final-correct').textContent = `${correctCount} / ${QUESTIONS.length}`;

            const msgEl = document.getElementById('result-message');
            if (score === 100) {
                msgEl.textContent = "Luar biasa! Anda pakar Makmal Jejak Virus dan memahami sepenuhnya cara mencegah influenza!";
            } else if (score >= 60) {
                msgEl.textContent = "Bagus sekali! Anda mengenali punca dan langkah pencegahan penularan virus influenza.";
            } else {
                msgEl.textContent = "Usaha yang baik! Mari ulang kaji semula supaya lebih mahir menjejak virus influenza.";
            }

            playSound('win');
        }

        /**
         * PENGURUSAN GELANG KEMAJUAN 2 SAAT & PENUNJUK BULATAN TENAGA
         */
        function resetDwellRing() {
            dwellRing.style.strokeDashoffset = RING_CIRCUMFERENCE;
        }

        function checkCursorHover(now) {
            if (!gameActive) return;

            let detectedTarget = null;

            // Semak sama ada penunjuk berada di atas kad jawapan (semasa belum dijawab)
            if (!isAnswered) {
                for (const card of answerCards) {
                    const rect = card.getBoundingClientRect();
                    if (
                        cursorX >= rect.left &&
                        cursorX <= rect.right &&
                        cursorY >= rect.top &&
                        cursorY <= rect.bottom
                    ) {
                        detectedTarget = card;
                        break;
                    }
                }
            } else {
                // Jika sudah dijawab, benarkan penunjuk mengaktifkan butang "Seterusnya" juga
                const rect = btnNextQuestion.getBoundingClientRect();
                if (
                    rect.width > 0 &&
                    cursorX >= rect.left &&
                    cursorX <= rect.right &&
                    cursorY >= rect.top &&
                    cursorY <= rect.bottom
                ) {
                    detectedTarget = btnNextQuestion;
                }
            }

            // Kemas kini kesan sasaran pada kad jawapan
            answerCards.forEach(c => {
                if (c === detectedTarget) {
                    c.classList.add('targeted');
                } else {
                    c.classList.remove('targeted');
                }
            });

            if (detectedTarget) {
                if (hoveredElement !== detectedTarget) {
                    hoveredElement = detectedTarget;
                    hoverStartTime = now;
                    playSound('hover');
                } else {
                    const elapsed = now - hoverStartTime;
                    const progress = Math.min(1, elapsed / DWELL_DURATION);
                    const offset = RING_CIRCUMFERENCE * (1 - progress);
                    dwellRing.style.strokeDashoffset = offset;

                    if (progress >= 1) {
                        const targetToTrigger = hoveredElement;
                        hoveredElement = null;
                        resetDwellRing();

                        if (targetToTrigger === btnNextQuestion) {
                            goToNextQuestion();
                        } else {
                            const idx = parseInt(targetToTrigger.getAttribute('data-index'), 10);
                            selectAnswer(idx);
                        }
                    }
                }
            } else {
                hoveredElement = null;
                resetDwellRing();
            }
        }

        /**
         * GELUNG ANIMASI UTAMA (GAME LOOP)
         */
        function animateLoop(now) {
            if (gameActive) {
                // Proses kamera jika mod kamera aktif
                if (now - lastFrameTime > 50) {
                    processCameraMotion();
                    lastFrameTime = now;
                }

                // Gerakkan bulatan tenaga dengan licin (interpolasi)
                cursorX += (targetCursorX - cursorX) * 0.22;
                cursorY += (targetCursorY - cursorY) * 0.22;

                energyCursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0)`;

                checkCursorHover(now);
            }

            requestAnimationFrame(animateLoop);
        }

        /**
         * PENDENGAR ACARA (EVENT LISTENERS)
         */
        // Gerakan Tetikus & Sentuhan
        window.addEventListener('mousemove', (e) => {
            targetCursorX = e.clientX;
            targetCursorY = e.clientY;
        });

        window.addEventListener('touchmove', (e) => {
            if (e.touches.length > 0) {
                targetCursorX = e.touches[0].clientX;
                targetCursorY = e.touches[0].clientY;
            }
        }, { passive: true });

        window.addEventListener('touchstart', (e) => {
            if (e.touches.length > 0) {
                targetCursorX = e.touches[0].clientX;
                targetCursorY = e.touches[0].clientY;
                cursorX = targetCursorX;
                cursorY = targetCursorY;
            }
        }, { passive: true });

        // Klik terus pada kad jawapan untuk keselesaan tambahan pada telefon/tetikus
        answerCards.forEach(card => {
            card.addEventListener('click', () => {
                if (!isAnswered) {
                    const idx = parseInt(card.getAttribute('data-index'), 10);
                    selectAnswer(idx);
                }
            });
        });

        // Butang Muka Depan
        document.getElementById('btn-mode-camera').addEventListener('click', () => startGame(true));
        document.getElementById('btn-mode-touch').addEventListener('click', () => startGame(false));

        // Butang Navigasi dalam Permainan
        btnNextQuestion.addEventListener('click', () => goToNextQuestion());

        document.getElementById('btn-toggle-mode').addEventListener('click', async () => {
            if (useCameraMode) {
                stopCamera();
            } else {
                await startCamera();
            }
        });

        document.getElementById('btn-back-home').addEventListener('click', () => {
            gameActive = false;
            stopCamera();
            energyCursor.style.display = 'none';
            gameScreen.classList.add('hidden');
            resultScreen.classList.add('hidden');
            startScreen.classList.remove('hidden');
        });

        // Butang Skrin Keputusan
        document.getElementById('btn-play-again').addEventListener('click', () => {
            startGame(useCameraMode);
        });

        document.getElementById('btn-result-home').addEventListener('click', () => {
            gameActive = false;
            stopCamera();
            energyCursor.style.display = 'none';
            resultScreen.classList.add('hidden');
            startScreen.classList.remove('hidden');
        });

        // Mulakan gelung animasi apabila halaman siap dimuatkan
        window.onload = function () {
            requestAnimationFrame(animateLoop);
        };
    </script>
</body>
</html>
