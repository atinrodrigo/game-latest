<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Misi Jejak Virus - Makmal Jejak Virus</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Nunito -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Tone.js untuk kesan bunyi makmal ceria -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

    <style>
        * {
            font-family: 'Nunito', sans-serif;
            user-select: none;
            -webkit-user-select: none;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #10264D 0%, #342665 100%);
            color: #ffffff;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Animasi terapung lembut untuk hiasan makmal di tepi */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(4deg); }
        }
        @keyframes floatReverse {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(10px) rotate(-5deg); }
        }
        .float-slow {
            animation: floatSlow 5s ease-in-out infinite;
        }
        .float-reverse {
            animation: floatReverse 6s ease-in-out infinite;
        }

        /* Kad Soalan & Jawapan Cerah */
        .lab-card {
            background-color: #F8FAFC;
            color: #172554;
            border: 3px solid #E2E8F0;
            box-shadow: 0 8px 0 rgba(15, 23, 42, 0.35);
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
        }

        /* Keadaan kad jawapan apabila disasarkan atau betul/salah */
        .answer-card.targeted {
            border-color: #67E8F9;
            background-color: #ECFEFF;
            transform: translateY(-3px);
            box-shadow: 0 10px 0 rgba(103, 232, 249, 0.35), 0 0 18px rgba(103, 232, 249, 0.45);
        }

        @keyframes popCorrect {
            0% { transform: scale(1); }
            40% { transform: scale(1.04); }
            100% { transform: scale(1); }
        }

        .answer-card.correct {
            border-color: #10B981 !important;
            background-color: #D1FAE5 !important;
            color: #065F46 !important;
            box-shadow: 0 8px 0 #059669 !important;
            animation: popCorrect 0.45s ease-out forwards;
        }

        .answer-card.wrong {
            border-color: #F43F5E !important;
            background-color: #FFE4E6 !important;
            color: #881337 !important;
            box-shadow: 0 8px 0 #E11D48 !important;
        }

        /* Butang Utama */
        .btn-cyan {
            background-color: #67E8F9;
            color: #172554;
            box-shadow: 0 6px 0 #0891B2;
            transition: all 0.15s ease;
        }
        .btn-cyan:hover {
            background-color: #A5F3FC;
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #0891B2;
        }
        .btn-cyan:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #0891B2;
        }

        .btn-pink {
            background-color: #F9A8D4;
            color: #172554;
            box-shadow: 0 6px 0 #DB2777;
            transition: all 0.15s ease;
        }
        .btn-pink:hover {
            background-color: #FBCFE8;
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #DB2777;
        }
        .btn-pink:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #DB2777;
        }

        .btn-yellow {
            background-color: #FDE68A;
            color: #172554;
            box-shadow: 0 6px 0 #D97706;
            transition: all 0.15s ease;
        }
        .btn-yellow:hover {
            background-color: #FEF08A;
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #D97706;
        }
        .btn-yellow:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #D97706;
        }

        /* Penunjuk Bulatan Tenaga Bercahaya (Menggantikan Perisai) */
        #energy-cursor {
            position: fixed;
            top: 0;
            left: 0;
            width: 84px;
            height: 84px;
            margin-left: -42px;
            margin-top: -42px;
            pointer-events: none;
            z-index: 9999;
            display: none;
            will-change: transform;
        }

        .energy-orb-core {
            width: 34px;
            height: 34px;
            border-radius: 9999px;
            background: radial-gradient(circle, #FFFFFF 15%, #67E8F9 65%, rgba(103, 232, 249, 0) 100%);
            box-shadow: 0 0 18px #67E8F9, 0 0 32px #F9A8D4;
            animation: pulseOrb 1.2s ease-in-out infinite alternate;
        }

        @keyframes pulseOrb {
            0% { transform: scale(0.92); opacity: 0.9; }
            100% { transform: scale(1.08); opacity: 1; }
        }

        /* Video Kamera dicerminkan */
        .mirror-video {
            transform: scaleX(-1);
        }

        /* Ukuran Teks Khusus mengikut Spesifikasi */
        @media (min-width: 1024px) {
            .question-typography {
                font-size: 28px;
                line-height: 1.35;
                font-weight: 600;
            }
            .answer-typography {
                font-size: 22px;
                line-height: 1.35;
                font-weight: 600;
            }
        }
        @media (max-width: 1023px) {
            .question-typography {
                font-size: 20px;
                line-height: 1.35;
                font-weight: 600;
            }
            .answer-typography {
                font-size: 17px;
                line-height: 1.35;
                font-weight: 600;
            }
        }
    </style>
</head>
<body class="min-h-screen lg:h-screen lg:overflow-hidden flex flex-col justify-between relative">

    <!-- ==================== HIASAN TEPI MAKMAL (MOLEKUL, KANTA PEMBESAR, PARTIKEL VIRUS) ==================== -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden z-0">
        <!-- Kiri Atas: Partikel Virus Kartun (Merah Jambu & Sian) -->
        <svg class="w-24 h-24 md:w-32 md:h-32 absolute top-6 left-4 md:left-8 opacity-85 float-slow" viewBox="0 0 120 120" fill="none">
            <circle cx="60" cy="60" r="30" fill="#F9A8D4" stroke="#172554" stroke-width="4"/>
            <!-- Paku Virus Bulat -->
            <line x1="60" y1="12" x2="60" y2="30" stroke="#F9A8D4" stroke-width="6" stroke-linecap="round"/>
            <circle cx="60" cy="10" r="7" fill="#67E8F9" stroke="#172554" stroke-width="3"/>
            <line x1="60" y1="90" x2="60" y2="108" stroke="#F9A8D4" stroke-width="6" stroke-linecap="round"/>
            <circle cx="60" cy="110" r="7" fill="#67E8F9" stroke="#172554" stroke-width="3"/>
            <line x1="12" y1="60" x2="30" y2="60" stroke="#F9A8D4" stroke-width="6" stroke-linecap="round"/>
            <circle cx="10" cy="60" r="7" fill="#67E8F9" stroke="#172554" stroke-width="3"/>
            <line x1="90" y1="60" x2="108" y2="60" stroke="#F9A8D4" stroke-width="6" stroke-linecap="round"/>
            <circle cx="110" cy="60" r="7" fill="#67E8F9" stroke="#172554" stroke-width="3"/>
            <line x1="25" y1="25" x2="39" y2="39" stroke="#F9A8D4" stroke-width="6" stroke-linecap="round"/>
            <circle cx="23" cy="23" r="6" fill="#FDE68A" stroke="#172554" stroke-width="3"/>
            <line x1="81" y1="81" x2="95" y2="95" stroke="#F9A8D4" stroke-width="6" stroke-linecap="round"/>
            <circle cx="97" cy="97" r="6" fill="#FDE68A" stroke="#172554" stroke-width="3"/>
            <line x1="95" y1="25" x2="81" y2="39" stroke="#F9A8D4" stroke-width="6" stroke-linecap="round"/>
            <circle cx="97" cy="23" r="6" fill="#FDE68A" stroke="#172554" stroke-width="3"/>
            <line x1="39" y1="81" x2="25" y2="95" stroke="#F9A8D4" stroke-width="6" stroke-linecap="round"/>
            <circle cx="23" cy="97" r="6" fill="#FDE68A" stroke="#172554" stroke-width="3"/>
            <!-- Bintik Comel -->
            <circle cx="50" cy="52" r="5" fill="#172554" opacity="0.25"/>
            <circle cx="70" cy="65" r="7" fill="#172554" opacity="0.25"/>
            <circle cx="52" cy="70" r="4" fill="#172554" opacity="0.25"/>
        </svg>

        <!-- Kanan Atas: Molekul Sains Bercantum -->
        <svg class="w-24 h-24 md:w-36 md:h-36 absolute top-6 right-4 md:right-8 opacity-85 float-reverse" viewBox="0 0 140 140" fill="none">
            <line x1="40" y1="75" x2="85" y2="40" stroke="#67E8F9" stroke-width="7" stroke-linecap="round"/>
            <line x1="40" y1="75" x2="95" y2="100" stroke="#67E8F9" stroke-width="7" stroke-linecap="round"/>
            <circle cx="40" cy="75" r="20" fill="#67E8F9" stroke="#172554" stroke-width="4"/>
            <circle cx="85" cy="40" r="15" fill="#FDE68A" stroke="#172554" stroke-width="4"/>
            <circle cx="95" cy="100" r="17" fill="#F9A8D4" stroke="#172554" stroke-width="4"/>
            <circle cx="34" cy="69" r="5" fill="#FFFFFF" opacity="0.7"/>
        </svg>

        <!-- Kiri Bawah: Kanta Pembesar Makmal -->
        <svg class="w-24 h-24 md:w-32 md:h-32 absolute bottom-6 left-4 md:left-10 opacity-85 float-reverse" viewBox="0 0 120 120" fill="none">
            <line x1="74" y1="74" x2="104" y2="104" stroke="#FDE68A" stroke-width="14" stroke-linecap="round"/>
            <line x1="74" y1="74" x2="104" y2="104" stroke="#172554" stroke-width="4" stroke-linecap="round"/>
            <circle cx="52" cy="52" r="32" fill="#10264D" stroke="#67E8F9" stroke-width="8"/>
            <circle cx="52" cy="52" r="24" fill="#67E8F9" fill-opacity="0.2"/>
            <!-- Silau Kanta -->
            <path d="M36 40 A16 16 0 0 1 56 32" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
            <!-- Partikel Mikro dalam Kanta -->
            <circle cx="54" cy="55" r="7" fill="#F9A8D4"/>
            <circle cx="43" cy="60" r="4" fill="#FDE68A"/>
        </svg>

        <!-- Kanan Bawah: Partikel Virus Kuning & Sian -->
        <svg class="w-20 h-20 md:w-28 md:h-28 absolute bottom-6 right-4 md:right-10 opacity-85 float-slow" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="22" fill="#FDE68A" stroke="#172554" stroke-width="4"/>
            <circle cx="50" cy="16" r="6" fill="#F9A8D4" stroke="#172554" stroke-width="3"/>
            <line x1="50" y1="22" x2="50" y2="28" stroke="#172554" stroke-width="4"/>
            <circle cx="50" cy="84" r="6" fill="#F9A8D4" stroke="#172554" stroke-width="3"/>
            <line x1="50" y1="72" x2="50" y2="78" stroke="#172554" stroke-width="4"/>
            <circle cx="16" cy="50" r="6" fill="#67E8F9" stroke="#172554" stroke-width="3"/>
            <line x1="22" y1="50" x2="28" y2="50" stroke="#172554" stroke-width="4"/>
            <circle cx="84" cy="50" r="6" fill="#67E8F9" stroke="#172554" stroke-width="3"/>
            <line x1="72" y1="50" x2="78" y2="50" stroke="#172554" stroke-width="4"/>
            <circle cx="44" cy="46" r="4" fill="#172554" opacity="0.25"/>
            <circle cx="57" cy="54" r="5" fill="#172554" opacity="0.25"/>
        </svg>
    </div>

    <!-- ==================== PENUNJUK BULATAN TENAGA BERCAHAYA (GELANG 2 SAAT) ==================== -->
    <div id="energy-cursor" class="flex items-center justify-center">
        <!-- Gelang Kemajuan 2 Saat -->
        <svg class="w-full h-full -rotate-90 absolute inset-0" viewBox="0 0 84 84">
            <circle cx="42" cy="42" r="34" stroke="rgba(255, 255, 255, 0.25)" stroke-width="6" fill="none" />
            <circle id="dwell-ring" cx="42" cy="42" r="34" stroke="#FDE68A" stroke-width="7" fill="none"
                stroke-dasharray="213.6" stroke-dashoffset="213.6" stroke-linecap="round" />
        </svg>
        <!-- Teras Bulatan Tenaga -->
        <div class="energy-orb-core"></div>
    </div>

    <!-- ==================== 1. MUKA DEPAN (START SCREEN) ==================== -->
    <main id="start-screen" class="relative z-10 flex-1 flex flex-col items-center justify-center px-4 py-8 min-h-screen">
        <div class="max-w-2xl w-full text-center flex flex-col items-center bg-[#10264D]/60 border-2 border-[#67E8F9]/30 rounded-3xl p-6 sm:p-10 md:p-12 shadow-2xl backdrop-blur-sm">
            
            <!-- Lencana Kecil Makmal -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#172554] border border-[#67E8F9] text-[#67E8F9] text-sm sm:text-base font-bold mb-5">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="M20 20l-4-4"/>
                </svg>
                <span>MAKMAL JEJAK VIRUS • TAHUN 4</span>
            </div>

            <!-- Tajuk Utama (Sangat Tebal, Tiada Cahaya Berlebihan) -->
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-[#67E8F9] mb-3">
                MISI JEJAK VIRUS
            </h1>

            <!-- Subtajuk -->
            <p class="text-lg sm:text-2xl text-[#FDE68A] font-semibold mb-8 max-w-lg">
                Kenali punca dan penularan influenza
            </p>

            <!-- Hiasan Ikon Mikro Makmal (Bukan Manusia/Superhero) -->
            <div class="flex items-center justify-center gap-6 mb-8">
                <!-- Ikon Molekul -->
                <div class="w-14 h-14 rounded-2xl bg-[#172554] border-2 border-[#F9A8D4] flex items-center justify-center">
                    <svg class="w-8 h-8" viewBox="0 0 40 40" fill="none">
                        <line x1="12" y1="26" x2="26" y2="12" stroke="#67E8F9" stroke-width="3"/>
                        <line x1="12" y1="26" x2="28" y2="28" stroke="#67E8F9" stroke-width="3"/>
                        <circle cx="12" cy="26" r="6" fill="#F9A8D4"/>
                        <circle cx="26" cy="12" r="5" fill="#FDE68A"/>
                        <circle cx="28" cy="28" r="5" fill="#67E8F9"/>
                    </svg>
                </div>
                <!-- Ikon Kanta Pembesar -->
                <div class="w-16 h-16 rounded-2xl bg-[#172554] border-2 border-[#67E8F9] flex items-center justify-center">
                    <svg class="w-9 h-9" viewBox="0 0 40 40" fill="none">
                        <circle cx="18" cy="18" r="10" stroke="#67E8F9" stroke-width="3.5" fill="#10264D"/>
                        <line x1="25" y1="25" x2="34" y2="34" stroke="#FDE68A" stroke-width="4.5" stroke-linecap="round"/>
                        <circle cx="18" cy="18" r="4" fill="#F9A8D4"/>
                    </svg>
                </div>
                <!-- Ikon Virus Kartun -->
                <div class="w-14 h-14 rounded-2xl bg-[#172554] border-2 border-[#FDE68A] flex items-center justify-center">
                    <svg class="w-8 h-8" viewBox="0 0 40 40" fill="none">
                        <circle cx="20" cy="20" r="9" fill="#FDE68A"/>
                        <circle cx="20" cy="6" r="2.5" fill="#F9A8D4"/>
                        <circle cx="20" cy="34" r="2.5" fill="#F9A8D4"/>
                        <circle cx="6" cy="20" r="2.5" fill="#67E8F9"/>
                        <circle cx="34" cy="20" r="2.5" fill="#67E8F9"/>
                        <circle cx="18" cy="18" r="2" fill="#172554"/>
                        <circle cx="23" cy="22" r="2.5" fill="#172554"/>
                    </svg>
                </div>
            </div>

            <!-- Dua Butang Pilihan Mod Permainan -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-xl mb-6">
                <button id="btn-mode-camera" class="btn-cyan w-full sm:w-1/2 py-4 px-6 rounded-2xl font-extrabold text-lg sm:text-xl flex items-center justify-center gap-3 cursor-pointer">
                    <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span>Main dengan Kamera</span>
                </button>

                <button id="btn-mode-touch" class="btn-pink w-full sm:w-1/2 py-4 px-6 rounded-2xl font-extrabold text-lg sm:text-xl flex items-center justify-center gap-3 cursor-pointer">
                    <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5" />
                    </svg>
                    <span>Main dengan Sentuhan</span>
                </button>
            </div>

            <!-- Arahan Ringkas -->
            <div class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-[#172554]/90 border border-[#FDE68A]/50 text-[#FDE68A] font-semibold text-base sm:text-lg">
                <span>✨ Arahan: Gerakkan tangan, pilih jawapan!</span>
            </div>
        </div>
    </main>

    <!-- ==================== 2. HALAMAN PERMAINAN (GAME SCREEN) ==================== -->
    <section id="game-screen" class="hidden relative z-10 w-full max-w-6xl mx-auto px-3 sm:px-6 py-2 sm:py-3 flex-1 flex flex-col justify-between min-h-screen lg:h-screen lg:max-h-screen overflow-y-auto lg:overflow-hidden">
        
        <!-- BAR ATAS: Kemajuan, Markah & Panel Khas Pratonton Kamera -->
        <header class="w-full bg-[#10264D]/90 border-2 border-[#67E8F9]/40 rounded-2xl px-3 sm:px-5 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0 shadow-lg">
            
            <!-- Kiri: Tajuk Kecil & Butang Utama -->
            <div class="flex items-center gap-2 sm:gap-3">
                <button id="btn-back-home" class="px-3 py-1.5 rounded-xl bg-[#172554] hover:bg-[#1e316d] border border-[#67E8F9]/50 text-[#67E8F9] font-bold text-xs sm:text-sm flex items-center gap-1.5 transition cursor-pointer" title="Kembali ke Muka Depan">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                    <span>Muka Depan</span>
                </button>
                <span class="hidden md:inline-block font-black text-[#67E8F9] text-base tracking-wide">
                    MAKMAL JEJAK VIRUS
                </span>
            </div>

            <!-- Tengah: Kemajuan Soalan & Markah -->
            <div class="flex items-center gap-3 sm:gap-5">
                <!-- Kemajuan -->
                <div class="flex items-center gap-2 bg-[#172554] px-3 py-1.5 rounded-xl border border-[#67E8F9]/40">
                    <span class="text-xs sm:text-sm font-bold text-[#67E8F9]">SOALAN</span>
                    <span id="progress-badge" class="text-sm sm:text-base font-extrabold text-white">1 / 5</span>
                    <div class="hidden sm:block w-20 h-2.5 bg-[#10264D] rounded-full overflow-hidden">
                        <div id="progress-bar-fill" class="h-full bg-[#67E8F9] transition-all duration-300" style="width: 20%;"></div>
                    </div>
                </div>

                <!-- Markah -->
                <div class="flex items-center gap-2 bg-[#172554] px-3.5 py-1.5 rounded-xl border border-[#FDE68A]/50">
                    <span class="text-xs sm:text-sm font-bold text-[#FDE68A]">MARKAH</span>
                    <span id="score-badge" class="text-sm sm:text-base font-extrabold text-white">0</span>
                </div>
            </div>

            <!-- Kanan: Panel Khas Pratonton Kamera (Tidak menutup soalan atau jawapan) -->
            <div class="flex items-center gap-2">
                <div id="camera-panel" class="flex items-center gap-2 bg-[#172554] px-2.5 py-1 rounded-xl border border-[#F9A8D4]/60">
                    <div class="relative w-16 h-11 sm:w-20 sm:h-12 rounded-lg overflow-hidden bg-slate-900 border border-[#67E8F9] shrink-0">
                        <video id="webcam-video" autoplay playsinline muted class="w-full h-full object-cover mirror-video hidden"></video>
                        <canvas id="motion-canvas" width="64" height="48" class="hidden"></canvas>
                        <div id="camera-placeholder" class="w-full h-full flex items-center justify-center text-[10px] text-[#67E8F9] font-semibold text-center px-1">
                            Mod Sentuh
                        </div>
                        <!-- Titik pengesan gerakan pada pratonton -->
                        <div id="cam-tracker-dot" class="hidden absolute w-2.5 h-2.5 rounded-full bg-[#67E8F9] border border-white -translate-x-1/2 -translate-y-1/2 pointer-events-none" style="left:50%;top:50%;"></div>
                    </div>
                    <div class="hidden xl:flex flex-col text-left">
                        <span id="control-status-label" class="text-xs font-bold text-[#F9A8D4]">Kawalan Tangan</span>
                        <span class="text-[11px] text-slate-200">Tahan 2s pada kad</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- RUANG TENGAH: Kotak Soalan Padat & 3 Kad Jawapan Sebaris -->
        <div class="flex-1 flex flex-col justify-center gap-3 sm:gap-4 my-2">
            
            <!-- KOTAK SOALAN (Dikecilkan & dikurangkan ruang kosong, warna cerah, tulisan #172554) -->
            <div class="lab-card rounded-2xl px-4 py-3 sm:px-6 sm:py-4 w-full max-w-4xl mx-auto text-center shrink-0">
                <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#172554] text-[#67E8F9] text-xs font-bold mb-1.5">
                    <span id="question-tag">UJIAN MAKMAL 1</span>
                </div>
                <h2 id="question-text" class="question-typography text-[#172554]">
                    Apakah punca utama jangkitan penyakit Influenza?
                </h2>
            </div>

            <!-- 3 KAD JAWAPAN SAMA BESAR DALAM SATU BARIS -->
            <div id="answers-grid" class="grid grid-cols-1 lg:grid-cols-3 gap-3 sm:gap-4 w-full items-stretch shrink-0">
                
                <!-- Kad Jawapan A -->
                <div data-index="0" class="answer-card lab-card rounded-2xl p-3.5 sm:p-5 flex flex-col justify-between cursor-pointer relative min-h-[105px] lg:min-h-[155px]">
                    <div class="flex items-center justify-between mb-2">
